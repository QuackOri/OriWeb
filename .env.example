# 선택 설정
# 1. 이 파일을 복사해서 같은 폴더에 .env 파일을 만듭니다. (.env는 Git에 올라가지 않음)
# 2. 필요한 값만 입력합니다. 비워 두면 해당 기능은 꺼집니다.
# 3. docker compose up --build -d 로 다시 실행합니다.

# GitHub OAuth 로그인 (README.md의 "GitHub 로그인 설정" 참고)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 관리자 계정: 앱 시작 시 이 아이디의 계정이 없으면 관리자로 생성 (아이디 영문/숫자 4~20자, 비밀번호 4자 이상)
ADMIN_USERNAME=
ADMIN_PASSWORD=
