# Optional settings
# 1. Copy this file to .env in the same folder (.env is not committed to Git).
# 2. Fill in only what you need. Leaving a value empty disables that feature.
# 3. Restart with: docker compose up --build -d

# GitHub OAuth login (see the GitHub login setup section in README.md)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin account: created on startup if no account with this username exists (username: 4-20 letters/digits, password: 4+ chars)
ADMIN_USERNAME=
ADMIN_PASSWORD=
